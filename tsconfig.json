{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "types/**/*",
    "models/**/*.ts",
    "services/**/*.ts",
    "controllers/**/*.ts",
    "utils/**/*.ts",
    "schemas/**/*.ts",
    "config/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "data",
    "uploads",
    "seed"
  ]
}
